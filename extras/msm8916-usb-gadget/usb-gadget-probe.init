#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2025 OpenWrt.org

START=99
STOP=09

USE_PROCD=1

start_service() {
	local mode
	mode=$(uci -q get usbgadget.usb.net_mode)

	# Only auto needs a decision.  Unset keeps the per-function booleans, and
	# ncm/rndis/both are a pin, so neither gets an instance.
	case "$mode" in
		auto) ;;
		*) return 0 ;;
	esac

	procd_open_instance
	procd_set_param command /usr/sbin/usb-gadget-probe
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
