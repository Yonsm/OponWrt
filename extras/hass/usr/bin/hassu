#!/bin/sh

PY_SITE=$(ls -d /usr/lib/python3.*/site-packages 2>/dev/null | head -n 1)

refine() {
	cd "$PY_SITE/homeassistant" 2>/dev/null || { echo "Could not fix Home Assistant installation"; exit 1; }
	echo "Refine Home Assistant installation by/for Yonsm"

	sed -i 's/_LOGGER.warning(CUSTOM_WARNING/#LOGGER.warning(CUSTOM_WARNING/' loader.py
	sed -i 's/minutes=30/days=30/' auth/const.py
	sed -i 's/ATTERY_MODELS:/ATTERY_MODELS and False:/' components/xiaomi_aqara/sensor.py
	sed -i 's/await hass.config_entries.async_forward_entry_setups/#wait hass.config_entries.async_forward_entry_setups/' components/mobile_app/__init__.py

	sed -i 's/Platform.BUTTON/#latform.BUTTON/' components/braviatv/__init__.py
	sed -i 's/f"{ATTR_MANUFACTURER} {model}"/model/' components/braviatv/entity.py

	sed -i 's/"RM4PRO", "RM4MINI"/"RM4PRO", "RMPRO", "RM4MINI"/' components/broadlink/sensor.py

	sed -i 's/await hass.config_entries.async_forward_entry_setups/#wait hass.config_entries.async_forward_entry_setups/' components/sun/__init__.py
	sed -i 's/await hass.config_entries.async_unload_platforms/True or await hass.config_entries.async_unload_platforms/' components/sun/__init__.py

	grep -q 'CONF_ICON_TEMPLATE,' components/mqtt/switch.py || sed -i 's/CONF_VALUE_TEMPLATE,/CONF_VALUE_TEMPLATE, CONF_ICON_TEMPLATE,/' components/mqtt/switch.py
	grep -q 'CONF_ICON_TEMPLATE)' components/mqtt/switch.py || sed -i 's/cv.template,/cv.template, vol.Optional(CONF_ICON_TEMPLATE): cv.template,/' components/mqtt/switch.py
	grep -q '"original_state": m' components/mqtt/switch.py || sed -i 's/payload = self._value_template/if CONF_VALUE_TEMPLATE in self._config: self._attr_state_attributes = {"original_state": msg.payload}\n            if CONF_ICON_TEMPLATE in self._config: self._attr_icon = self._config[CONF_ICON_TEMPLATE].async_render_with_possible_json_value(msg.payload)\n            payload = self._value_template/' components/mqtt/switch.py
	grep -q 'state_attributes(s,' components/mqtt/switch.py || sed -i 's/def _prepare_subscribe_topics/@property\n    def state_attributes(self): return self._attr_state_attributes if hasattr(self, "_attr_state_attributes") else None\n\n    def _prepare_subscribe_topics/' components/mqtt/switch.py
}

fixso() {
	for DIR in /root/.homeassistant/deps/lib/python3.*/site-packages "$PY_SITE"; do
		[ -d "$DIR" ] && find "$DIR" -name "*cpython-*.so" -exec "$0" {} \;
	done
}

firstrun() {
	[ "${1:0:1}" = "-" ] && refine
	grep -q hass /etc/rc.local || sed -i 's#exit 0#sleep 5; hass -c /opt/.homeassistant >/dev/null \&\nexit 0#' /etc/rc.local
	echo
	echo "WARNING: Home Assistant will fail on first run, run 'hass' again after Ctrl+C"
	echo
	fixso
	hass -v
	fixso
}

case "$1" in
*.so)
	FILE="${1##*/}"
	ln -sf "$FILE" "${1%/*}/${FILE%%.*}.so"
	;;
fixso|-f)
	fixso
	;;
refine|-e)
	refine
	;;
install|-i)
	mkdir -p /opt/.homeassistant
	ln -sf /opt/.homeassistant /root/
	if command -v apk >/dev/null 2>&1; then
		apk update && apk add python3-cffi
	else
		opkg update && opkg install python3-cffi
	fi
	pip install --upgrade pip
	pip install tzdata homeassistant && firstrun "$1"
	;;
upgrade|-u)
	killall hass
	pip install --upgrade homeassistant && firstrun "$1"
	;;
start|-s)
	hass &
	;;
restart|-r)
	killall hass
	hass &
	;;
stop|-t)
	killall hass
	;;
*)
	echo "Usage: $0 <install|upgrade|start|restart|stop|refine|fixso|*.so>"
	;;
esac
